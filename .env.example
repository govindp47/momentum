# Momentum local configuration

# Optional: override the default SQLite database location.
# Example:
# MOMENTUM_DATA_DIR=/path/to/momentum/tracker.db
MOMENTUM_DATA_DIR=

# Runtime environment and logging.
MOMENTUM_ENVIRONMENT=development
MOMENTUM_LOG_LEVEL=INFO
MOMENTUM_PERSISTENT_LOG_LEVEL=WARNING

# Comma-separated usernames that can access developer-only features.
MOMENTUM_DEVELOPER_USERNAMES=

# Authentication settings.
MOMENTUM_AUTH_COOKIE_SECURE=false
MOMENTUM_AUTH_SESSION_DAYS=30
